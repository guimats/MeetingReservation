@page "/reservas"
@rendermode InteractiveWebAssembly

@using System.Net.Http.Json
@using MeetingReservation.Communication.Responses
@using MeetingReservation.Communication.Requests

@inject HttpClient Http

<div class="container-fluid py-4 min-vh-100">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-0">Gestão de Reservas</h2>
            <p class="text-secondary small mt-1">Consulte e gerencie as reuniões agendadas</p>
        </div>
        <!-- Botão com a nova classe btn-gradient -->
        <button class="btn btn-gradient fw-semibold px-4 py-2 rounded-3 shadow-sm">
            <i class="bi bi-plus-lg me-2"></i> Nova Reserva
        </button>
    </div>

    <!-- Área de Filtros -->
    <div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
        <h5 class="fw-semibold text-dark mb-3 fs-6">Filtros de Pesquisa</h5>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-medium small text-secondary">Nome</label>
                <input type="text" class="form-control" placeholder="Ex: Reunião de Pauta" @bind-value="@RequestFilter.Name">
            </div>
            <div class="col-md-4">
                <label class="form-label fw-medium small text-secondary">Descrição</label>
                <input type="text" class="form-control" placeholder="Palavra-chave" @bind-value="@RequestFilter.Description"/>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-medium small text-secondary">Mínimo de Participantes</label>
                <input type="number" class="form-control" placeholder="0" min="1" @bind-value="@RequestFilter.MinParticipants"/>
            </div>
            <!-- Botão com a nova classe btn-gradient -->
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-gradient w-100 fw-semibold shadow-sm py-2" @onclick="FilterReservationsAsync">
                    <i class="bi bi-search me-2"></i> Pesquisar
                </button>
            </div>
        </div>
    </div>

    <!-- Listagem de Reservas -->
    <div class="d-flex flex-column gap-3">
        @foreach (ResponseShortReservationJson reserva in Reservations)
        {
            <div class="card reserva-card border-0 shadow-sm rounded-3">
                <div class="card-body d-flex justify-content-between align-items-center p-3 p-md-4">

                    <!-- Informações da Reserva -->
                    <div>
                        <h5 class="fw-bold mb-1 text-dark fs-5">@reserva.Name</h5>
                        <p class="text-secondary mb-2 small">@reserva.Description</p>

                        <div class="d-flex flex-wrap gap-3 text-muted small mt-2">
                            <span class="bg-light px-2 py-1 rounded">
                                <i class="bi bi-people-fill text-primary me-1"></i> @reserva.Participants participantes
                            </span>
                            <span class="bg-light px-2 py-1 rounded">
                                <i class="bi bi-door-open-fill text-primary me-1"></i> @reserva.RoomName
                            </span>
                            <span class="bg-light px-2 py-1 rounded">
                                <i class="bi bi-calendar-event-fill text-primary me-1"></i> @reserva.InitialTime.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </div>
                    </div>

                    <!-- Ações -->
                    <div class="acoes-container d-flex gap-2" @onclick:stopPropagation="true">
                        <button class="btn btn-outline-primary btn-sm rounded-2 px-3" title="Editar">
                            <i class="bi bi-pencil-fill"></i>
                        </button>
                        <button class="btn btn-outline-danger btn-sm rounded-2 px-3" title="Excluir">
                            <i class="bi bi-trash-fill"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    public class ReservaDto
    {
        public int Id { get; set; }
        public string Nome { get; set; } = string.Empty;
        public string Descricao { get; set; } = string.Empty;
        public int MinimoParticipantes { get; set; }
        public string SalaNome { get; set; } = string.Empty;
        public DateTime DataAgendamento { get; set; }
    }

    private List<ReservaDto> ReservasMock { get; set; } = new List<ReservaDto>
    {
        new ReservaDto
        {
            Id = 1,
            Nome = "Planejamento Estratégico Q3",
            Descricao = "Reunião com a diretoria para alinhamento das metas do próximo trimestre.",
            MinimoParticipantes = 12,
            SalaNome = "Sala Master (Andar 2)",
            DataAgendamento = new DateTime(2026, 6, 15, 14, 0, 0)
        },
        new ReservaDto
        {
            Id = 2,
            Nome = "Review da Sprint - Equipe Backend",
            Descricao = "Apresentação das entregas da semana e retrospectiva.",
            MinimoParticipantes = 5,
            SalaNome = "Sala Ágil (Andar 1)",
            DataAgendamento = new DateTime(2026, 6, 16, 10, 0, 0)
        },
        new ReservaDto
        {
            Id = 3,
            Nome = "Treinamento de C# e .NET 9",
            Descricao = "Workshop técnico para padronização de arquitetura Limpa e DDD.",
            MinimoParticipantes = 20,
            SalaNome = "Auditório Principal",
            DataAgendamento = new DateTime(2026, 6, 20, 09, 0, 0)
        }
    };

    private IList<ResponseShortReservationJson> Reservations { get; set; } = [];
    private RequestFilterReservationsJson RequestFilter { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await FilterReservationsAsync();
    }

    private async Task FilterReservationsAsync()
    {
        var result = await Http.PostAsJsonAsync<RequestFilterReservationsJson>("reservation/filter", RequestFilter);

        if (result.IsSuccessStatusCode == false)
            return;

        var resultData = await result.Content.ReadFromJsonAsync<ResponseReservationsJson>();

        if (resultData is null)
            return;

        Reservations = resultData.Reservations;
    }
}