@if (IsVisible)
{
    <div class="modal-overlay" @onclick="OnClose"></div>
    <div class="modal-wrapper">
        <div class="card border-0 shadow-lg modal-card">

            <div class="modal-card-header">
                <div class="d-flex align-items-center gap-2">
                    @if (Icon is not null)
                    {
                        <div class="modal-header-icon">@Icon</div>
                    }
                    <h5 class="mb-0 text-white fw-semibold">@Title</h5>
                </div>
                <button class="btn-close-modal" @onclick="OnClose" type="button">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                    </svg>
                </button>
            </div>

            <div class="card-body px-4 py-4">
                <EditForm Model="@Model" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />

                    @Fields

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 py-2 small mb-3" role="alert">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="flex-shrink-0" viewBox="0 0 16 16">
                                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                            </svg>
                            <span>@ErrorMessage</span>
                        </div>
                    }

                    <div class="d-flex gap-2 mt-1">
                        <button type="button" class="btn btn-outline-secondary flex-fill py-2"
                                @onclick="OnClose">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary-custom flex-fill py-2 fw-semibold"
                                disabled="@IsLoading">
                            @if (IsLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Salvando...</span>
                            }
                            else
                            {
                                <span>@SubmitLabel</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public object Model { get; set; } = new();
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public string SubmitLabel { get; set; } = "Salvar";
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string ErrorMessage { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Fields { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }

    private async Task HandleValidSubmit(EditContext _)
        => await OnSubmit.InvokeAsync();
}
